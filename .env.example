# Leave both Supabase values empty for the local demo (sample pools, demo
# profiles, simulated card holds, editable backend settings).
#
# Setting both turns the build into a store build: it connects only to this
# backend, requires sign-in, and hides every demo feature. For EAS builds, set
# these as EAS environment variables (eas env:create) on the "preview" and
# "production" environments instead of committing them.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the privacy policy (for example https://<your-vercel-domain>/privacy).
# Shown on the sign-in screen and the account screen.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
