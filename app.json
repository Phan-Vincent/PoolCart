{
  "expo": {
    "name": "PoolCart",
    "slug": "poolcart",
    "owner": "phanvincent",
    "scheme": "poolcart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.poolcart.grocerygroupbuy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "venmo"
        ]
      }
    },
    "android": {
      "package": "com.poolcart.grocerygroupbuy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D9488"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "poolcart"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "PoolCart — Neighborhood Grocery Group Buys",
      "shortName": "PoolCart",
      "themeColor": "#0D9488",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D9488"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1dbf10f7-fe5b-4255-bd18-89b88358aab6"
      }
    }
  }
}
